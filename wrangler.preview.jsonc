{
  "name": "model-converter",
  "main": "worker/preview.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "model.white-box.cc",
      "custom_domain": true
    }
  ]
}
